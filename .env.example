# ==============================================================================
# InternTrack AI Environment Configuration
# ==============================================================================

# Core Settings
DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production-interntrack-ai-key-secret-2026
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL by default; falls back to SQLite if DB_NAME is empty)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=interntrack_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis & Celery (Set CELERY_TASK_ALWAYS_EAGER=True to run synchronously without Redis)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True

# AI & LLM Integration (Google Gemini API)
# Get a key at: https://aistudio.google.com/
# If omitted or invalid, InternTrack AI automatically runs in high-fidelity Local NLP Fallback mode!
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# JWT Configuration
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS / Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
